      "item": [
        {
          "name": "1. Buscar Pontos Próximos (Geoespacial)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/collection-points?lat=-23.5678&lng=-46.6845&radius_km=5&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "collection-points"],
              "query": [
                { "key": "lat", "value": "-23.5678", "description": "Latitude do usuário" },
                { "key": "lng", "value": "-46.6845", "description": "Longitude do usuário" },
                { "key": "radius_km", "value": "5", "description": "Raio de busca em quilômetros" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Consulta pontos de coleta próximos utilizando cálculo geoespacial PostGIS ST_DWithin / ST_Distance."
          },
          "response": []
        },
        {
