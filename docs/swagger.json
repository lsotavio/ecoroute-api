    "/api/v1/schedules": {
      "post": {
        "summary": "Criar agendamento de descarte",
        "tags": [
          "Agendamentos"
        ],
        "description": "Registra um agendamento de descarte com validação de capacidade diária e compatibilidade de resíduos.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "collection_point_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "user_name": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 100
                  },
                  "user_email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 120
                  },
                  "scheduled_date": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "waste_category": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 50
                  },
                  "items_description": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 500
                  }
                },
                "required": [
                  "collection_point_id",
                  "user_name",
                  "user_email",
                  "scheduled_date",
                  "waste_category",
                  "items_description"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "collection_point_id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "user_name": {
                      "type": "string"
                    },
                    "user_email": {
                      "type": "string",
                      "format": "email"
                    },
                    "scheduled_date": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "string",
                          "format": "date-time"
                        }
                      ]
                    },
                    "waste_category": {
                      "type": "string"
                    },
                    "items_description": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "PENDING",
                        "CONFIRMED",
                        "COMPLETED",
                        "CANCELLED"
                      ]
                    },
                    "created_at": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "string",
                          "format": "date-time"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "collection_point_id",
                    "user_name",
                    "user_email",
                    "scheduled_date",
                    "waste_category",
                    "items_description",
                    "status"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
