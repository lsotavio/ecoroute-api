    "/api/v1/health": {
      "get": {
        "summary": "Verificação de integridade da API",
        "tags": [
          "Sistema"
        ],
        "description": "Retorna o status atual do serviço, ambiente e conectividade.",
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
