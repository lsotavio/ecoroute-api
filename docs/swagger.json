                    },
                    "accepted_categories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "max_daily_capacity": {
                      "type": "number"
                    },
                    "is_active": {
                      "type": "boolean"
                    },
                    "created_at": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "string",
                          "format": "date-time"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "address",
                    "latitude",
                    "longitude",
                    "accepted_categories",
