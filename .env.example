# EcoRoute API - Environment Configuration

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://ecoroute:ecoroute_password@localhost:5432/ecoroute_db

# Fallback mode (Set to true if running without PostgreSQL/PostGIS for local sandbox testing)
USE_IN_MEMORY_DB=false
